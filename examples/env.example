ULTRASEARCH_TRANSPORT=stdio
ULTRASEARCH_SEARXNG_URL=http://127.0.0.1:8099
ULTRASEARCH_CACHE_URL=redis://localhost:6381
ULTRASEARCH_HOSTED_FALLBACK_ENABLED=false
ULTRASEARCH_PROVIDER_ORDER=tinyfish,parallel,brave,tavily,you,deepseek,exa
ULTRASEARCH_TINYFISH_API_KEY=
ULTRASEARCH_TINYFISH_LOCATION=CA
ULTRASEARCH_PARALLEL_API_KEY=
ULTRASEARCH_BRAVE_API_KEY=
ULTRASEARCH_TAVILY_API_KEY=
ULTRASEARCH_YOU_API_KEY=
ULTRASEARCH_DEEPSEEK_API_KEY=
ULTRASEARCH_DEEPSEEK_SEARCH_NEED_CONTENT=false
ULTRASEARCH_EXA_API_KEY=

# Hard caps keep finite free allowances from silently rolling into paid usage.
# Update these if the provider changes the active account allowance.
ULTRASEARCH_PARALLEL_SEARCH_BUDGET_MONTHLY_UNITS=5000
ULTRASEARCH_BRAVE_SEARCH_BUDGET_MONTHLY_UNITS=1000
ULTRASEARCH_TAVILY_SEARCH_BUDGET_MONTHLY_UNITS=1000
# You.com REST credits, DeepSeek and Exa are operator-defined. Set caps when desired.
# ULTRASEARCH_YOU_SEARCH_BUDGET_MONTHLY_UNITS=
# ULTRASEARCH_DEEPSEEK_SEARCH_BUDGET_MONTHLY_UNITS=
# ULTRASEARCH_EXA_SEARCH_BUDGET_MONTHLY_UNITS=
ULTRASEARCH_HOSTED_SEARCH_BUDGET_FAIL_OPEN=false

# Optional BYOK remote fetch/crawl escalation; no local sidecar is enabled.
ULTRASEARCH_FIRECRAWL_URL=
ULTRASEARCH_FIRECRAWL_API_KEY=
